{
  "name": "pi-deepseek-web-tools",
  "version": "0.1.0-alpha.2",
  "description": "DeepSeek Search and Fetch tools for pi with rich result cards and request-level billing",
  "type": "module",
  "license": "MIT",
  "author": "yms",
  "keywords": [
    "pi-package",
    "pi-extension",
    "deepseek",
    "web-search",
    "web-fetch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiyms/pi-deepseek-web-tools.git"
  },
  "bugs": {
    "url": "https://github.com/hiyms/pi-deepseek-web-tools/issues"
  },
  "homepage": "https://github.com/hiyms/pi-deepseek-web-tools#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-transform-types \"tests/*.test.ts\"",
    "test:integration": "node --test --experimental-transform-types \"tests/integration/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
